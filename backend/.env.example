# ===== Next-AI 后端配置 =====
# 复制本文件为 .env 后填写

# ---- LLM（OpenAI 兼容接口，用于对话和知识摘要）----
# 例如 https://api.openai.com/v1 或公司内部网关地址
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Embedding（OpenAI 兼容接口，用于知识库向量化）----
# 例如 text-embedding-3-small / bge-m3 等
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---- 应用 ----
# 数据目录（SQLite 数据库、上传文件等）
DATA_DIR=./data
# 允许的跨域来源，逗号分隔
CORS_ORIGINS=*
